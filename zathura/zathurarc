# Zathura — minimal PDF viewer config (Tokyo Night UI)
# ====================================================

# General
set selection-clipboard   clipboard
set adjust-open           "best-fit"
set scroll-page-aware     true
set scroll-step           100
set zoom-center           true
set render-loading        false
set window-title-basename true
set statusbar-basename    true
set statusbar-page-percent true
set page-padding          2

# Keys
map K zoom in
map J zoom out
map <Space> toggle_index
map <C-v>   toggle_fullscreen
map w       recolor
map R       rotate

# UI colors (document itself is shown as-is; `w` toggles dark recolor)
set default-bg            "#1f2335"
set statusbar-bg          "#24283b"
set statusbar-fg          "#c0caf5"
set inputbar-bg           "#1f2335"
set inputbar-fg           "#c0caf5"
set notification-bg       "#24283b"
set notification-fg       "#c0caf5"
set notification-error-bg "#24283b"
set notification-error-fg "#f7768e"
set notification-warning-bg "#24283b"
set notification-warning-fg "#e0af68"
set completion-bg         "#24283b"
set completion-fg         "#c0caf5"
set completion-highlight-bg "#7aa2f7"
set completion-highlight-fg "#1f2335"
set index-bg              "#24283b"
set index-fg              "#c0caf5"
set index-active-bg       "#2e3c64"
set index-active-fg       "#c0caf5"
set highlight-color       "rgba(224,175,104,0.4)"
set highlight-active-color "rgba(122,162,247,0.4)"

set recolor               false
set recolor-lightcolor    "#24283b"
set recolor-darkcolor     "#c0caf5"
set recolor-keephue       true

# LaTeX only: SyncTeX backward search into Neovim (needs nvim started with --listen / vimtex)
# Disabling the sandbox is required for this; comment both out if you never use LaTeX.
set synctex               true
set sandbox               none
